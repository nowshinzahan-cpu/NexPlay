# ===========================================
# NexPlay - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Application
PORT=5000
NODE_ENV=development

# Database - MongoDB
# Local: mongodb://localhost:27017/nexplay
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexplay
MONGO_URI=mongodb://localhost:27017/nexplay

# JWT Authentication
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email Service (SendGrid - optional)
# Sign up: https://sendgrid.com/free/
SENDGRID_API_KEY=
EMAIL_FROM=noreply@nexplay.com

# SMS Service (Twilio - optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Client Application
CLIENT_URL=http://localhost:5173

# Security
BCRYPT_SALT_ROUNDS=12

# File Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# SMTP (Nodemailer fallback - optional)
# Used when SendGrid is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend (optional - place in root .env or frontend/.env)
# VITE_API_URL=http://localhost:5000
