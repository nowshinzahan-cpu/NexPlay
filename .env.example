# ──────────────────────────────────────────────
# NexPlay — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to server/.env and fill in values

# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────
# Local: mongodb://localhost:27017/nexplay
# Atlas: mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/nexplay?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/nexplay

# ── JWT Authentication ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Client ─────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── External APIs (optional) ──────────────────
# TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Sports data provider (api-sports.io or similar)
SPORTS_API_KEY=

# ── Email (optional — uses Ethereal dev by default) ─
# Primary: SendGrid
SENDGRID_API_KEY=
# Nodemailer fallback SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nexplay.com

# ── SMS (optional) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Rate Limiting ──────────────────────────────
# Limits are INCREASED for development/testing (defaults in middleware/rateLimiter.js):
#   API requests:       1000 per 15 min  (~66/min)
#   Login attempts:     100 per 15 min   (~6.7/min)
#   Registration:        50 per hour      (~0.8/min)
#   Password reset:     100 per 15 min
#   OTP requests:        30 per 15 min
# Rate limiter is bypassed entirely in NODE_ENV=test

# ── File Uploads ───────────────────────────────
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
BCRYPT_SALT_ROUNDS=12

# ── Socket.io (optional) ───────────────────────
SOCKET_CORS_ORIGIN=http://localhost:5173
